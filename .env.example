# Server Port (Automatically set by Hostycare / cPanel Node.js Selector, defaults to 3000)
PORT=3000
NODE_ENV=production

# Google Gemini API key for AI MLM Growth Coach and Strategic Advisory
GEMINI_API_KEY=

# Razorpay Payment Gateway (Server-side keys for Online Payment Checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

